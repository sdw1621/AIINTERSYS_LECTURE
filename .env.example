# ─────────────────────────────────────────────────────────────
# 관리자
# ─────────────────────────────────────────────────────────────
# 관리자 페이지(/admin) 및 접수 조회 API 비밀번호
# 미설정 시 기본값 "aiintersys" 가 사용됩니다. 운영 환경에서는 반드시 변경하세요.
ADMIN_PASSWORD=change-me

# ─────────────────────────────────────────────────────────────
# 데이터베이스 (Postgres)
# ─────────────────────────────────────────────────────────────
# Neon / Supabase / Vercel Postgres 등 모든 Postgres 호환.
# 미설정 시 data/applications.json 파일에 저장됩니다 (서버리스에서는 비영속).
# 예: postgres://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=

# ─────────────────────────────────────────────────────────────
# 이메일 (Resend)
# ─────────────────────────────────────────────────────────────
# https://resend.com 에서 발급. 미설정 시 발송은 생략되고 접수는 정상 진행됩니다.
RESEND_API_KEY=
# 발신 주소. 도메인 인증 전에는 Resend 제공 주소를 사용하세요.
MAIL_FROM=AI인터시스 <onboarding@resend.dev>
# 신규 접수 알림을 받을 관리자 이메일 (선택)
ADMIN_EMAIL=

# ─────────────────────────────────────────────────────────────
# Claude Design 특강 사이트 (/design) — 선택
# 미설정 시 위의 공통 값(ADMIN_PASSWORD / MAIL_FROM / ADMIN_EMAIL)을 그대로 사용합니다.
# ─────────────────────────────────────────────────────────────
# 특강 접수 현황(/design/admin) 전용 비밀번호
DESIGN_ADMIN_PASSWORD=
# 특강 접수 메일 발신 주소
DESIGN_MAIL_FROM=Claude Design 특강 <onboarding@resend.dev>
# 특강 신규 접수 알림을 받을 이메일
DESIGN_ADMIN_EMAIL=
